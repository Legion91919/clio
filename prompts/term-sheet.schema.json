{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clio/term-sheet.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["loanAmount", "margin", "maturity"],
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "confidence", "page", "line"],
      "properties": {
        "value": { "type": ["string", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "page": { "type": ["integer", "null"], "minimum": 1 },
        "line": { "type": ["integer", "null"], "minimum": 1 }
      }
    }
  },
  "properties": {
    "loanAmount": { "$ref": "#/$defs/field", "description": "ISO currency code and amount, e.g. 'ZAR 48500000.00'" },
    "margin": { "$ref": "#/$defs/field", "description": "Percent over the base rate, e.g. '2.85'" },
    "maturity": { "$ref": "#/$defs/field", "description": "ISO date, e.g. '2031-06-30'" }
  }
}
