# Copy to .env (git-ignored) or export. Never commit real values.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5201
# Development only: password for the seeded demo users (analyst@example.com, committee@example.com).
# Leave empty and the API generates one and prints it once to the console.
Demo__Password=
# Confidence at or above which a field is saved without review (tuned from the eval set).
Extraction__ReviewThreshold=0.90
Extraction__MaxUploadBytes=10485760
Extraction__QueueCapacity=500
# rules (built) | llm (documented port, refuses to start until an adapter exists; see ADR-0003)
Extraction__Model=rules
